# Rust
/target/
**/target/
debug/
*.rs.bk
*.rlib
*.prof*

# Node / TypeScript
node_modules/
dist/
build/
*.log
*.tsbuildinfo
.npm/
# Root dev-tooling lockfile (lint/format only; installed with `npm install`, not pinned).
/package-lock.json

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Go
*.exe
*.test
*.out
/vendor/

# WASM / build artifacts
pkg/
*.wasm

# Native FFI build outputs
*.dylib
*.so
*.a
*.dll
*.node

# Compiled demo binary (build artifact, not source)
/examples/go_demo/cleverbase-go-demo

# Coverage
coverage/
*.profraw
lcov.info

# Generated API documentation. The committed docs are the hand-written .md sources
# (docs/README.md, docs/limitations.md, ...); the rustdoc/gomarkdoc/pdoc/typedoc output under
# docs/api/ is produced by scripts/gen-docs.sh (and the docs workflow) and must never be tracked.
# (target/ for rustdoc and node_modules/ for typedoc are already ignored above.)
/docs/api/

# Env / secrets (never commit Cleverbase client secrets, TSA creds, etc.)
.env*
!.env.example
*.pem
*.key

# Generated test-PKI artifacts. The synthetic test material is committed as DER / PKCS#8
# (*.der, *.pk8); the openssl integration tests materialize any PEMs they need into a per-call
# temp dir, so these mutable openssl bookkeeping files must never be tracked.
/tests/fixtures/pki/*.srl
/tests/fixtures/pki/*serial*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.tmp
